ADMIN_PASSWORD=change-me
STAFF_PASSWORD=change-me
SUPABASE_URL=https://your-project.supabase.co

# Preferred for new Supabase projects. Use the backend/elevated key that starts with sb_secret_.
SUPABASE_SECRET_KEY=your-secret-key

# Optional legacy fallback if your project still shows a service_role key.
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=your-openai-api-key
OPENAI_CHAT_MODEL=gpt-5.4-mini

# Optional: use OpenRouter for answer generation/model access.
# Supabase semantic search still needs OPENAI_API_KEY for embeddings.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_SITE_URL=http://localhost:8501
OPENROUTER_APP_NAME=Cleaning SOP Assistant
